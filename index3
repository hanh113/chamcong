<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Hệ Thống Chấm Công</title>
    <base href="./" />
    <!-- Link Bootstrap CSS for styling -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" />
    <!-- Link FontAwesome for icons -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />
    <style>
        body {
            background-color: #f8f9fa;
            font-family: system-ui, -apple-system, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
        }
        .navbar-brand {
            font-weight: bold;
            letter-spacing: 1px;
        }
        .card {
            border: none;
            border-radius: 10px;
            box-shadow: 0 4px 6px rgba(0, 0, 0, 0.05);
        }
        .table-responsive {
            border-radius: 10px;
            overflow: hidden;
        }
        .status-present {
            background-color: #d1e7dd;
            color: #0f5132;
            padding: 4px 8px;
            border-radius: 20px;
            font-size: 0.85rem;
            font-weight: 500;
        }
        .status-absent {
            background-color: #f8d7da;
            color: #842029;
            padding: 4px 8px;
            border-radius: 20px;
            font-size: 0.85rem;
            font-weight: 500;
        }
    </style>
</head>
<body>

    <!-- Navigation Bar -->
    <nav class="navbar navbar-expand-lg navbar-dark bg-dark mb-4">
        <div class="container-fluid">
            <a class="navbar-brand" href="#"><i class="fa-solid fa-user-check me-2"></i>HỆ THỐNG CHẤM CÔNG</a>
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav">
                <span class="navbar-toggler-icon"></span>
            </button>
            <div class="collapse navbar-collapse" id="navbarNav">
                <ul class="navbar-nav ms-auto">
                    <li class="nav-item">
                        <a class="nav-link active" href="#"><i class="fa-solid fa-house me-1"></i> Trang chủ</a>
                    </li>
                </ul>
            </div>
        </div>
    </nav>

    <!-- Main Content Container -->
    <div class="container">
        <!-- Dashboard Summary -->
        <div class="row g-3 mb-4">
            <div class="col-md-4">
                <div class="card p-3 bg-white text-dark">
                    <div class="d-flex align-items-center justify-content-between">
                        <div>
                            <h6 class="text-muted text-uppercase mb-1">Tổng nhân viên</h6>
                            <h3 class="mb-0 fw-bold">45</h3>
                        </div>
                        <div class="bg-primary text-white p-3 rounded-circle">
                            <i class="fa-solid fa-users fa-xl"></i>
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-md-4">
                <div class="card p-3 bg-white text-dark">
                    <div class="d-flex align-items-center justify-content-between">
                        <div>
                            <h6 class="text-muted text-uppercase mb-1">Đã chấm công</h6>
                            <h3 class="mb-0 fw-bold text-success">42</h3>
                        </div>
                        <div class="bg-success text-white p-3 rounded-circle">
                            <i class="fa-solid fa-calendar-check fa-xl"></i>
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-md-4">
                <div class="card p-3 bg-white text-dark">
                    <div class="d-flex align-items-center justify-content-between">
                        <div>
                            <h6 class="text-muted text-uppercase mb-1">Vắng mặt</h6>
                            <h3 class="mb-0 fw-bold text-danger">3</h3>
                        </div>
                        <div class="bg-danger text-white p-3 rounded-circle">
                            <i class="fa-solid fa-user-slash fa-xl"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Attendance Table Card -->
        <div class="card p-4">
            <div class="d-flex justify-content-between align-items-center mb-3 flex-wrap gap-2">
                <h5 class="mb-0 fw-bold"><i class="fa-solid fa-list me-2"></i>Danh Sách Chấm Công Ngày Hôm Nay</h5>
                <button class="btn btn-primary btn-sm" onclick="window.print()">
                    <i class="fa-solid fa-print me-1"></i> In báo cáo
                </button>
            </div>
            
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th>Mã NV</th>
                            <th>Họ và Tên</th>
                            <th>Giờ Vào</th>
                            <th>Giờ Ra</th>
                            <th>Trạng Thái</th>
                            <th>Ghi chú</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr>
                            <td class="fw-bold">NV001</td>
                            <td>Nguyễn Văn A</td>
                            <td>07:55 AM</td>
                            <td>17:05 PM</td>
                            <td><span class="status-present">Đúng giờ</span></td>
                            <td class="text-muted">-</td>
                        </tr>
                        <tr>
                            <td class="fw-bold">NV002</td>
                            <td>Trần Thị B</td>
                            <td>08:15 AM</td>
                            <td>17:00 PM</td>
                            <td><span class="status-present">Đi muộn</span></td>
                            <td class="text-danger">Muộn 15 phút</td>
                        </tr>
                        <tr>
                            <td class="fw-bold">NV003</td>
                            <td>Lê Hoàng C</td>
                            <td>-</td>
                            <td>-</td>
                            <td><span class="status-absent">Vắng mặt</span></td>
                            <td class="text-muted">Nghỉ phép có lý do</td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <!-- Bootstrap JS Bundle -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
